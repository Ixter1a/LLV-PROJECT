{
  "manifest_version": 3,
  "name": "LLV Смены FunPay",
  "version": "2.4.3",
  "description": "Панель продавца FunPay: автоподнятие, автоответы, лоты, статистика, темы и учёт смен.",
  "minimum_chrome_version": "109",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LLV Смены",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "notifications", "scripting", "tabs"],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://*.github.io/*"
    ]
  },
  "host_permissions": ["https://funpay.com/*"],
  "optional_host_permissions": ["https://*.supabase.co/*", "https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://funpay.com/*"],
      "js": [
        "order-parser.js",
        "seller-utils.js",
        "themes.js",
        "lots.js",
        "lots-ui.js",
        "chat.js",
        "sales.js",
        "review.js",
        "market.js",
        "translate.js",
        "ai.js",
        "background-loop.js",
        "page-tools.js",
        "seller-tools.js",
        "settings-page.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.png", "icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"],
      "matches": ["https://funpay.com/*"]
    }
  ]
}
