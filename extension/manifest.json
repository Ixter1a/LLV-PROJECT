{
  "manifest_version": 3,
  "key": "",
  "name": "LLV Смена",
  "version": "1.0.0",
  "description": "Кнопка «Начать смену» на FunPay и передача новых продаж в панель LLV.",
  "action": {
    "default_title": "LLV Смена",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "host_permissions": ["https://funpay.com/*", "https://*.funpay.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/mark.png", "overlay.css"],
      "matches": ["https://funpay.com/*", "https://*.funpay.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://funpay.com/*", "https://*.funpay.com/*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
