{
  "manifest_version": 3,
  "name": "LLV Смены FunPay",
  "version": "1.0.0",
  "description": "Кнопка смены на FunPay: читает видимые завершённые заказы и отправляет их в Supabase.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LLV Смены",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://funpay.com/*"],
  "optional_host_permissions": ["https://*.supabase.co/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://funpay.com/*"],
      "js": ["order-parser.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon.png", "icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"],
      "matches": ["https://funpay.com/*"]
    }
  ]
}
